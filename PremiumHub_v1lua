-- تبويب اللاعب
CreateInput(PlayerTab, "⚡ سرعة المشي (رقم)", function(val)
    local num = tonumber(val)
    if num then 
        local char = localPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid").WalkSpeed = num
        end
    end
end)

CreateInput(PlayerTab, "🦘 قوة القفز (رقم)", function(val)
    local num = tonumber(val)
    if num then 
        local char = localPlayer.Character
        if char and char:FindFirstChildOfClass("Humanoid") then
            char:FindFirstChildOfClass("Humanoid").UseJumpPower = true
            char:FindFirstChildOfClass("Humanoid").JumpPower = num
        end
    end
end)

CreateInput(PlayerTab, "🛸 سرعة الطيران", function(val)
    local num = tonumber(val)
    if num then flySpeed = num end
end)

CreateToggle(PlayerTab, "🛸 تفعيل الطيران", function(state)
    flying = state
    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then return end

    if flying then
        local bv = Instance.new("BodyVelocity")
        bv.Name = "PremiumFly"
        bv.MaxForce = Vector3.new(100000, 100000, 100000)
        bv.Velocity = Vector3.zero
        bv.Parent = root

        task.spawn(function()
            local camera = workspace.CurrentCamera
            while flying and scriptRunning and character.Parent do
                local humanoid = character:FindFirstChildOfClass("Humanoid")
                if not humanoid then break end

                local moveDir = humanoid.MoveDirection
                if moveDir.Magnitude > 0 then
                    local camLook = camera.CFrame.LookVector
                    local flatCam = Vector3.new(camLook.X, 0, camLook.Z)
                    local yDir = flatCam.Magnitude > 0 and (camLook.Y * flatCam.Unit:Dot(moveDir) * 1.5) or 0
                    local finalDir = Vector3.new(moveDir.X, yDir, moveDir.Z).Unit
                    root.CFrame = root.CFrame + (finalDir * flySpeed)
                end
                if humanoid.Jump then root.CFrame = root.CFrame + Vector3.new(0, flySpeed, 0) end
                RunService.RenderStepped:Wait()
            end
        end)
    else
        local bv = root:FindFirstChild("PremiumFly")
        if bv then bv:Destroy() end
    end
end)

-- تبويب الانتقال (Teleport)
CreateButton(TeleportTab, "📌 حفظ الإحداثيات الحالية", Theme.Accent, function()
    local root = localPlayer.Character and localPlayer.Character:FindFirstChild("HumanoidRootPart")
    if root then savedCFrame = root.CFrame end
end)

CreateButton(TeleportTab, "🚀 العودة للإحداثيات المحفوظة", Theme.Success, function()
    if savedCFrame then safeTeleport(savedCFrame) end
end)

CreateToggle(TeleportTab, "🛡️ العودة التلقائية (حماية)", function(state)
    autoReturnEnabled = state
end)

CreateInput(TeleportTab, "📏 مسافة العودة التلقائية (مثال: 50)", function(val)
    local num = tonumber(val)
    if num then autoReturnDistance = num end
end)

CreateButton(TeleportTab, "📄 نسخ الإحداثيات", Theme.ElementBg, function()
    if savedCFrame and setclipboard then setclipboard(tostring(savedCFrame)) end
end)

-- تشغيل الكود المساعد للعودة التلقائية
task.spawn(function()
    while scriptRunning do
        if autoReturnEnabled and savedCFrame and not isTeleporting then
            local char = localPlayer.Character
            local root = char and char:FindFirstChild("HumanoidRootPart")
            if root and (root.Position - savedCFrame.Position).Magnitude > autoReturnDistance then
                safeTeleport(savedCFrame)
            end
        end
        task.wait(0.5)
    end
end)

