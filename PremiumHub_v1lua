local function safeTeleport(targetCFrame)
    if isTeleporting then return end
    isTeleporting = true

    local character = localPlayer.Character
    local root = character and character:FindFirstChild("HumanoidRootPart")
    if not root then isTeleporting = false return end

    local overlay = Instance.new("Frame", ScreenGui)
    overlay.Size = UDim2.new(1, 0, 1, 0)
    overlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
    overlay.BackgroundTransparency = 1
    overlay.ZIndex = 100

    local loadCard = Instance.new("Frame", overlay)
    loadCard.Size = UDim2.new(0, 280, 0, 100)
    loadCard.Position = UDim2.new(0.5, -140, 0.5, -30)
    loadCard.BackgroundColor3 = Theme.Sidebar
    loadCard.BackgroundTransparency = 1
    loadCard.ZIndex = 101
    Instance.new("UICorner", loadCard).CornerRadius = UDim.new(0, 12)
    
    local stroke = Instance.new("UIStroke", loadCard)
    stroke.Color = Theme.Accent
    stroke.Transparency = 1

    local title = Instance.new("TextLabel", loadCard)
    title.Size = UDim2.new(1, 0, 0, 50)
    title.BackgroundTransparency = 1
    title.Font = Enum.Font.GothamBlack
    title.Text = "🚀 جاري النقل الآمن..."
    title.TextColor3 = Theme.TextPrimary
    title.TextSize = 18
    title.TextTransparency = 1
    title.ZIndex = 102

    local barBg = Instance.new("Frame", loadCard)
    barBg.Size = UDim2.new(0.8, 0, 0, 6)
    barBg.Position = UDim2.new(0.1, 0, 0.6, 0)
    barBg.BackgroundColor3 = Theme.ElementBg
    barBg.BackgroundTransparency = 1
    barBg.ZIndex = 102
    Instance.new("UICorner", barBg).CornerRadius = UDim.new(1, 0)

    local barFill = Instance.new("Frame", barBg)
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = Theme.Accent
    barFill.ZIndex = 103
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

    -- الأنيميشن
    TweenService:Create(blurEffect, TweenInfo.new(0.5), {Size = 20}):Play()
    TweenService:Create(overlay, TweenInfo.new(0.5), {BackgroundTransparency = 0.5}):Play()
    TweenService:Create(loadCard, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {Position = UDim2.new(0.5, -140, 0.5, -50), BackgroundTransparency = 0}):Play()
    TweenService:Create(stroke, TweenInfo.new(0.5), {Transparency = 0}):Play()
    TweenService:Create(title, TweenInfo.new(0.5), {TextTransparency = 0}):Play()
    TweenService:Create(barBg, TweenInfo.new(0.5), {BackgroundTransparency = 0}):Play()
    
    TweenService:Create(barFill, TweenInfo.new(1.2, Enum.EasingStyle.Sine), {Size = UDim2.new(1, 0, 1, 0)}):Play()

    local safePlatform = Instance.new("Part", workspace)
    safePlatform.Size = Vector3.new(20, 1, 20)
    safePlatform.Position = targetCFrame.Position - Vector3.new(0, 3.5, 0)
    safePlatform.Anchored = true
    safePlatform.Transparency = 1 

    root.CFrame = targetCFrame
    root.Anchored = true

    task.delay(1.5, function()
        if root then root.Anchored = false end
        if safePlatform then safePlatform:Destroy() end
        
        TweenService:Create(blurEffect, TweenInfo.new(0.5), {Size = 0}):Play()
        TweenService:Create(overlay, TweenInfo.new(0.5), {BackgroundTransparency = 1}):Play()
        TweenService:Create(loadCard, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -140, 0.5, -20), BackgroundTransparency = 1}):Play()
        TweenService:Create(stroke, TweenInfo.new(0.4), {Transparency = 1}):Play()
        TweenService:Create(title, TweenInfo.new(0.4), {TextTransparency = 1}):Play()
        TweenService:Create(barBg, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        TweenService:Create(barFill, TweenInfo.new(0.4), {BackgroundTransparency = 1}):Play()
        
        task.wait(0.5)
        overlay:Destroy()
        isTeleporting = false
    end)
end

